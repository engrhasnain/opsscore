# Where the OpsCore API runs (backend: python -m uvicorn app.main:app --port 8000).
# On Vercel this is set automatically by the service binding in vercel.json.
OPSCORE_API_URL=http://127.0.0.1:8000
# Password of the demo accounts created by `python -m app.cli seed-demo`
OPSCORE_DEMO_PASSWORD=demo-password-1234
