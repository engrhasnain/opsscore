# Copy to .env for local development. Every setting is optional in development.

OPSCORE_ENVIRONMENT=development
OPSCORE_DATABASE_URL=sqlite:///./opscore.db
# OPSCORE_DATABASE_URL=postgresql+psycopg://opscore_app:PASSWORD@localhost:5432/opscore
# OPSCORE_MIGRATION_DATABASE_URL=postgresql+psycopg://opscore:PASSWORD@localhost:5432/opscore

# Required in production: a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# OPSCORE_JWT_SECRET=

# OPSCORE_CORS_ORIGINS=["https://ops.example.com"]

# Notifications ("log" writes to the console instead of sending)
OPSCORE_EMAIL_PROVIDER=log
OPSCORE_SMS_PROVIDER=log
# OPSCORE_SMTP_HOST=smtp.example.com
# OPSCORE_SMTP_FROM=alerts@example.com
# OPSCORE_SMTP_USERNAME=
# OPSCORE_SMTP_PASSWORD=
# OPSCORE_TWILIO_ACCOUNT_SID=
# OPSCORE_TWILIO_AUTH_TOKEN=
# OPSCORE_TWILIO_SMS_FROM=+15555550100
# OPSCORE_TWILIO_WHATSAPP_FROM=+15555550100

# Ops Assistant: Claude understands paraphrases; without it, keyword matching is used.
OPSCORE_ASSISTANT_LLM_ENABLED=false
# OPSCORE_ASSISTANT_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
